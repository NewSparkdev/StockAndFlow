<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Application Info -->
    <AssemblyName>StockAndFlow</AssemblyName>
    <Version>1.0.0</Version>
    <Company>Stock &amp; Flow</Company>
    <Product>Stock &amp; Flow Inventory Management</Product>
    <Description>Inventory and sales management system</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Single File Publishing -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared business logic, models, view models and data layer -->
    <ProjectReference Include="..\StockAndFlow.Core\StockAndFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF-only UI dependencies; all other packages come transitively from StockAndFlow.Core -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Serilog" Version="4.3.0" />
  </ItemGroup>

</Project>
