<UserControl x:Class="StockAndFlow.Views.RecordSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#95A5A6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#27AE60" Padding="20">
            <StackPanel Orientation="Horizontal">
                <Button Content="← Back to Sales"
                        Command="{Binding CancelCommand}"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="0"
                        FontSize="14"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0"/>
                <TextBlock Text="Record New Sale"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!-- Inventory Item Selection -->
                <TextBlock Text="Select Item *" Style="{StaticResource LabelStyle}"/>
                <ComboBox ItemsSource="{Binding AvailableItems}"
                         SelectedItem="{Binding SelectedItem}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock FontSize="10" Foreground="#7F8C8D">
                                    <Run Text="SKU:"/>
                                    <Run Text="{Binding Sku}"/>
                                    <Run Text=" | Available:"/>
                                    <Run Text="{Binding QuantityOnHand}"/>
                                    <Run Text=" | Price:"/>
                                    <Run Text="{Binding SalePrice, StringFormat=C2}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Stock Warning -->
                <Border Background="#FFF3CD"
                        Padding="10"
                        Margin="0,0,0,15"
                        BorderBrush="#FFC107"
                        BorderThickness="1"
                        CornerRadius="3"
                        Visibility="{Binding ShowLowStockWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding StockWarningMessage}"
                                   Foreground="#856404"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Quantity -->
                <TextBlock Text="Quantity *" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Sale Price Per Unit -->
                <TextBlock Text="Sale Price Per Unit *" Style="{StaticResource LabelStyle}"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                            Text="{Binding SalePricePerUnit, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                    <Button Grid.Column="1"
                            Content="Reset"
                            Command="{Binding ResetPriceCommand}"
                            Margin="5,0,0,0"
                            Padding="10,8"
                            ToolTip="Reset to item's default price"/>
                </Grid>

                <!-- Customer Name (Optional) -->
                <TextBlock Text="Customer Name" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Customer Email (Optional) -->
                <TextBlock Text="Customer Email" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding CustomerEmail, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Notes (Optional) -->
                <TextBlock Text="Notes" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         Height="60"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>

                <!-- Sale Summary -->
                <Border Background="#E8F5E9"
                        Padding="15"
                        Margin="0,15,0,0"
                        BorderBrush="#81C784"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding ShowSaleSummary, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock FontWeight="Bold"
                                   Foreground="#2E7D32"
                                   Margin="0,0,0,10">Sale Summary:</TextBlock>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Revenue:" FontSize="11" Foreground="#555"/>
                                <TextBlock Text="{Binding CalculatedRevenue, StringFormat=C2}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#2E7D32"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Profit:" FontSize="11" Foreground="#555"/>
                                <TextBlock Text="{Binding CalculatedProfit, StringFormat=C2}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#2E7D32"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Margin:" FontSize="11" Foreground="#555"/>
                                <TextBlock Text="{Binding CalculatedMargin, StringFormat={}{0:F1}%}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#2E7D32"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#BDC3C7"
                BorderThickness="0,1,0,0"
                Padding="20">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,10,0"
                        Width="100"/>
                <Button Content="Record Sale"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        Width="120"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
