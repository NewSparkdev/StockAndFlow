<Window x:Class="StockAndFlow.Views.Dialogs.ShopifySettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shopify Sync"
        Width="560"
        Height="560"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <Style TargetType="TextBox" x:Key="InputStyle">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#3498DB" Padding="20">
            <StackPanel>
                <TextBlock Text="Shopify Sync"
                          FontSize="20"
                          FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock Text="Pull products and orders from your Shopify store; push inventory counts back"
                          FontSize="13"
                          Foreground="#E8F4F8"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <CheckBox Content="Enable Shopify sync"
                          IsChecked="{Binding ShopifyEnabled}"
                          FontWeight="SemiBold"
                          Margin="0,5,0,5"/>

                <TextBlock Text="Store name" Style="{StaticResource LabelStyle}" ToolTip="{Binding StoreNameHelpText}"/>
                <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource InputStyle}"
                        ToolTip="{Binding StoreNameHelpText}"/>
                <TextBlock Text="The part before .myshopify.com — pasting the full address works too."
                          FontSize="11" Foreground="#7F8C8D" Margin="0,3,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="Admin API access token" Style="{StaticResource LabelStyle}" ToolTip="{Binding AccessTokenHelpText}"/>
                <PasswordBox x:Name="TokenBox"
                             Padding="8"
                             FontSize="14"
                             BorderBrush="#BDC3C7"
                             BorderThickness="1"
                             PasswordChanged="OnTokenChanged"
                             ToolTip="{Binding AccessTokenHelpText}"/>
                <TextBlock Text="Shopify admin → Settings → Apps and sales channels → Develop apps → create an app with read_products, read_orders, write_inventory → install → copy the shpat_ token. Stored encrypted on this computer only."
                          FontSize="11" Foreground="#7F8C8D" Margin="0,3,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="Stock counts" Style="{StaticResource LabelStyle}" Margin="0,20,0,5"/>
                <TextBlock Text="Stock &amp; Flow keeps the real count — it's the only place that sees your market and craft-fair sales too. Syncing brings online orders in; it never overwrites your counts."
                          FontSize="11" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,0,0,8"
                          ToolTip="{Binding StockOwnershipHelpText}"/>
                <CheckBox Content="Send my stock counts to Shopify after each sync"
                          IsChecked="{Binding PushStockLevels}"
                          ToolTip="{Binding StockOwnershipHelpText}"/>
                <TextBlock Text="Keeps your storefront from selling something you already sold in person."
                          FontSize="11" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="24,2,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="Test Connection"
                            Command="{Binding TestConnectionCommand}"
                            Padding="15,8"
                            Margin="0,0,10,0"
                            Background="#95A5A6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Sync Now"
                            Command="{Binding SyncNowCommand}"
                            Padding="15,8"
                            Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    <ProgressBar IsIndeterminate="True"
                                 Width="80" Height="8" Margin="12,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}"
                          FontSize="12"
                          Foreground="#2C3E50"
                          Margin="0,12,0,0"
                          TextWrapping="Wrap"/>

                <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" Margin="0,16,0,8"/>
                <TextBlock Text="Did a stock-take in Shopify's admin? This replaces your counts with theirs — it asks first."
                          FontSize="11" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Button Content="Use Shopify's stock counts"
                        Command="{Binding AdoptShopifyStockCommand}"
                        HorizontalAlignment="Left"
                        Padding="15,8"
                        Background="#95A5A6" Foreground="White" BorderThickness="0" Cursor="Hand"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="15" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                       Command="{Binding CancelCommand}"
                       Padding="20,10"
                       Margin="0,0,10,0"
                       Background="#95A5A6" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                <Button Content="Save"
                       Command="{Binding SaveCommand}"
                       Padding="20,10"
                       Background="#27AE60" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
