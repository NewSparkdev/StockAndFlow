<Window x:Class="StockAndFlow.Views.Dialogs.ExpenseDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Expense Details"
        Width="600"
        Height="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#E74C3C" Padding="20">
            <StackPanel>
                <TextBlock Text="💸 Expense Details"
                          FontSize="20"
                          FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock Text="{Binding Expense.Category}"
                          FontSize="16"
                          Foreground="#FFEBEE"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- Expense Information -->
                <Border Background="White" Padding="15" Margin="0,0,0,20" BorderBrush="#BDC3C7" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Expense Information" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="Category" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Expense.Category}"
                                  Style="{StaticResource ValueStyle}"
                                  FontSize="16"
                                  FontWeight="Bold"/>

                        <TextBlock Text="Amount" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Expense.Amount, StringFormat=C2}"
                                  Style="{StaticResource ValueStyle}"
                                  FontSize="24"
                                  FontWeight="Bold"
                                  Foreground="#E74C3C"/>

                        <TextBlock Text="Expense Date &amp; Time" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding ExpenseDate, UpdateSourceTrigger=PropertyChanged}"
                                   Margin="0,0,0,15"
                                   FontSize="14"
                                   Padding="8"/>

                        <TextBlock Text="Description" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Expense.Description, TargetNullValue='No description provided'}"
                                  Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Receipt Image -->
                <Border Background="White"
                       Padding="15"
                       Margin="0,0,0,20"
                       BorderBrush="#BDC3C7"
                       BorderThickness="1"
                       Visibility="{Binding Expense.HasReceipt, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Receipt Image" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Image Source="{Binding Expense.ReceiptImagePath}"
                              MaxHeight="300"
                              Stretch="Uniform"
                              HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding Expense.ReceiptImagePath}"
                                  FontSize="10"
                                  Foreground="#95A5A6"
                                  Margin="0,5,0,0"
                                  TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Linked Inventory Item -->
                <Border Background="White"
                       Padding="15"
                       Margin="0,0,0,20"
                       BorderBrush="#BDC3C7"
                       BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Linked Inventory Item" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="Item Name" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Expense.LinkedItemName, TargetNullValue='Not linked to any inventory item'}"
                                  Style="{StaticResource ValueStyle}"/>

                        <TextBlock Text="Item ID" Style="{StaticResource LabelStyle}"
                                  Visibility="{Binding Expense.HasLinkedItem, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding Expense.LinkedInventoryItemId}"
                                  Style="{StaticResource ValueStyle}"
                                  FontFamily="Consolas"
                                  FontSize="11"
                                  Visibility="{Binding Expense.HasLinkedItem, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- Metadata -->
                <Border Background="White" Padding="15" BorderBrush="#BDC3C7" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Metadata" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="Expense ID" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Expense.Id}"
                                  Style="{StaticResource ValueStyle}"
                                  FontFamily="Consolas"
                                  FontSize="11"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="15" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close"
                       Command="{Binding CloseCommand}"
                       Padding="20,10"
                       Margin="0,0,10,0"
                       Background="#95A5A6"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="SemiBold"
                       Cursor="Hand"/>

                <Button Content="Save Changes"
                       Command="{Binding SaveCommand}"
                       Padding="20,10"
                       Background="#27AE60"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="SemiBold"
                       Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
