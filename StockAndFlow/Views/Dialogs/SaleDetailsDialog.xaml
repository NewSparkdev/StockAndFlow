<Window x:Class="StockAndFlow.Views.Dialogs.SaleDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sale Details"
        Width="700"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#27AE60" Padding="20">
            <StackPanel>
                <TextBlock Text="💰 Sale Transaction Details"
                          FontSize="20"
                          FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock Text="{Binding Transaction.ItemSummary}"
                          FontSize="14"
                          Foreground="#E8F5E9"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- Transaction Information -->
                <Border Background="White" Padding="15" Margin="0,0,0,15" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Transaction Information" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="Transaction Date &amp; Time" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding SaleDate, UpdateSourceTrigger=PropertyChanged}"
                                   Margin="0,0,0,15"
                                   FontSize="14"
                                   Padding="8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Total Items" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Transaction.ItemCount}"
                                          Style="{StaticResource ValueStyle}"
                                          FontSize="18"
                                          FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Total Quantity" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Transaction.TotalQuantity}"
                                          Style="{StaticResource ValueStyle}"
                                          FontSize="18"
                                          FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Items List -->
                <Border Background="White" Padding="15" Margin="0,0,0,15" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Items in This Sale" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <ItemsControl ItemsSource="{Binding Transaction.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#ECF0F1" BorderThickness="0,0,0,1" Padding="10,10,10,15" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding ItemName}" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                                <TextBlock FontSize="12" Foreground="#7F8C8D">
                                                    <Run Text="Quantity:"/>
                                                    <Run Text="{Binding Quantity}" FontWeight="Bold"/>
                                                    <Run Text=" × "/>
                                                    <Run Text="{Binding SalePricePerUnit, StringFormat=C2}"/>
                                                    <Run Text=" per unit"/>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="#95A5A6" Margin="0,3,0,0">
                                                    <Run Text="Cost:"/>
                                                    <Run Text="{Binding COGS, Mode=OneWay, StringFormat=C2}"/>
                                                    <Run Text=" | Profit:"/>
                                                    <Run Text="{Binding Profit, Mode=OneWay, StringFormat=C2}" Foreground="#27AE60"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Revenue" FontSize="10" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding Revenue, Mode=OneWay, StringFormat=C2}"
                                                          FontWeight="Bold"
                                                          FontSize="16"
                                                          Foreground="#27AE60"
                                                          HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Financial Summary -->
                <Border Background="White" Padding="15" Margin="0,0,0,15" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Financial Summary" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Total Revenue" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Transaction.Revenue, Mode=OneWay, StringFormat=C2}"
                                          Style="{StaticResource ValueStyle}"
                                          FontSize="20"
                                          FontWeight="Bold"
                                          Foreground="#27AE60"/>

                                <TextBlock Text="Total COGS" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Transaction.COGS, Mode=OneWay, StringFormat=C2}"
                                          Style="{StaticResource ValueStyle}"
                                          FontSize="16"
                                          Foreground="#E74C3C"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Total Profit" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Transaction.Profit, Mode=OneWay, StringFormat=C2}"
                                          Style="{StaticResource ValueStyle}"
                                          FontSize="20"
                                          FontWeight="Bold"
                                          Foreground="#3498DB"/>

                                <TextBlock Text="Profit Margin" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Transaction.ProfitMargin, Mode=OneWay, StringFormat={}{0:F2}%}"
                                          Style="{StaticResource ValueStyle}"
                                          FontSize="16"
                                          FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Customer Information -->
                <Border Background="White" Padding="15" Margin="0,0,0,15" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Customer Information" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="Customer Name" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Transaction.CustomerName, TargetNullValue='Not specified'}"
                                  Style="{StaticResource ValueStyle}"/>

                        <TextBlock Text="Customer Email" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Transaction.CustomerEmail, TargetNullValue='Not specified'}"
                                  Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Notes -->
                <Border Background="White" Padding="15" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Notes" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        <TextBlock Text="{Binding Transaction.Notes, TargetNullValue='No notes'}"
                                  Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Transaction ID -->
                <Border Background="White" Padding="15" Margin="0,15,0,0" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Transaction ID" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Transaction.TransactionId}"
                                  Style="{StaticResource ValueStyle}"
                                  FontFamily="Consolas"
                                  FontSize="11"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="15" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close"
                       Command="{Binding CloseCommand}"
                       Padding="20,10"
                       Margin="0,0,10,0"
                       Background="#95A5A6"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="SemiBold"
                       Cursor="Hand"/>

                <Button Content="Save Changes"
                       Command="{Binding SaveCommand}"
                       Padding="20,10"
                       Background="#27AE60"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="SemiBold"
                       Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
