<Window x:Class="StockAndFlow.Views.Dialogs.RecordAdjustmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Inventory Adjustment"
        Width="550"
        Height="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#E67E22" Padding="20">
            <StackPanel>
                <TextBlock Text="📦 Inventory Adjustment"
                          FontSize="20"
                          FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock Text="Record damaged items, returns, losses, or corrections"
                          FontSize="12"
                          Foreground="#FFEBEE"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!-- Inventory Item Selection -->
                <TextBlock Text="Inventory Item *" Style="{StaticResource LabelStyle}"/>
                <ComboBox ItemsSource="{Binding InventoryItems}"
                         SelectedItem="{Binding SelectedItem, UpdateSourceTrigger=PropertyChanged}"
                         DisplayMemberPath="Name"/>

                <!-- Current Quantity Display -->
                <Border Background="#E8F5E9"
                       Padding="10"
                       Margin="0,0,0,15"
                       BorderBrush="#81C784"
                       BorderThickness="1"
                       CornerRadius="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Current Quantity" FontSize="11" Foreground="#555"/>
                            <TextBlock Text="{Binding CurrentQuantity}"
                                      FontWeight="Bold"
                                      FontSize="16"
                                      Foreground="#2E7D32"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="New Quantity" FontSize="11" Foreground="#555"/>
                            <TextBlock Text="{Binding NewQuantity}"
                                      FontWeight="Bold"
                                      FontSize="16"
                                      Foreground="#2E7D32"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Adjustment Reason -->
                <TextBlock Text="Reason *" Style="{StaticResource LabelStyle}"/>
                <ComboBox ItemsSource="{Binding AdjustmentReasons}"
                         SelectedValue="{Binding SelectedReason, UpdateSourceTrigger=PropertyChanged}"
                         DisplayMemberPath="Display"
                         SelectedValuePath="Reason"/>

                <!-- Quantity Change -->
                <TextBlock Text="Quantity Change *" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding QuantityChange, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Use negative numbers to reduce inventory (e.g., -5 for 5 damaged items)"
                          FontSize="11"
                          Foreground="#7F8C8D"
                          Margin="0,-12,0,15"
                          TextWrapping="Wrap"/>

                <!-- Financial Loss Display (for negative adjustments) -->
                <Border Background="#FFEBEE"
                       Padding="15"
                       Margin="0,0,0,15"
                       BorderBrush="#E74C3C"
                       BorderThickness="1"
                       CornerRadius="3"
                       Visibility="{Binding IsLoss, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="💸 Financial Loss" FontWeight="Bold" FontSize="12" Foreground="#C62828" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Quantity Lost:" FontSize="11" Foreground="#666" Margin="0,0,0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding QuantityLost}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cost Lost:" FontSize="11" Foreground="#666" Margin="0,0,0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CostLost, StringFormat=C2, Mode=OneWay}" FontWeight="SemiBold" FontSize="11" Foreground="#E74C3C" Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Potential Revenue Lost:" FontSize="11" Foreground="#666" Margin="0,0,0,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PotentialRevenueLost, StringFormat=C2, Mode=OneWay}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>

                            <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,5"/>
                        </Grid>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Potential Profit Lost:" FontWeight="Bold" FontSize="12" Foreground="#C62828"/>
                            <TextBlock Grid.Column="1" Text="{Binding PotentialProfitLost, StringFormat=C2, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="#C62828"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Adjustment Date -->
                <TextBlock Text="Adjustment Date *" Style="{StaticResource LabelStyle}"/>
                <DatePicker SelectedDate="{Binding AdjustmentDate, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,0,15"/>

                <!-- Notes -->
                <TextBlock Text="Notes" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#BDC3C7"
                BorderThickness="0,1,0,0"
                Padding="20">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Padding="20,10"
                        Margin="0,0,10,0"
                        Background="#95A5A6"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Width="100"/>
                <Button Content="Record"
                        Command="{Binding RecordCommand}"
                        Padding="20,10"
                        Background="#E67E22"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Width="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
