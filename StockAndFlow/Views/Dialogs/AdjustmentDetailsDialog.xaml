<Window x:Class="StockAndFlow.Views.Dialogs.AdjustmentDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjustment Details"
        Width="650"
        Height="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#E67E22" Padding="20">
            <StackPanel>
                <TextBlock Text="📦 Adjustment Details"
                          FontSize="20"
                          FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock Text="{Binding Adjustment.ReasonDisplay}"
                          FontSize="16"
                          Foreground="#FFEBEE"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!-- Adjustment Information -->
                <Border Background="White" Padding="15" Margin="0,0,0,20" BorderBrush="#BDC3C7" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Adjustment Information" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="Inventory Item" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Adjustment.InventoryItemName}"
                                  Style="{StaticResource ValueStyle}"
                                  FontSize="16"
                                  FontWeight="Bold"/>

                        <TextBlock Text="Reason" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Adjustment.ReasonDisplay}"
                                  Style="{StaticResource ValueStyle}"
                                  FontSize="16"
                                  FontWeight="Bold"/>

                        <TextBlock Text="Quantity Change" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Adjustment.QuantityChangeDisplay}"
                                  Style="{StaticResource ValueStyle}"
                                  FontSize="24"
                                  FontWeight="Bold"
                                  Foreground="{Binding Adjustment.QuantityChangeColor}"/>

                        <TextBlock Text="Adjustment Date" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding AdjustmentDate, UpdateSourceTrigger=PropertyChanged}"
                                   Margin="0,0,0,15"
                                   FontSize="14"
                                   Padding="8"/>

                        <TextBlock Text="Notes" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Adjustment.Notes, TargetNullValue='No notes provided'}"
                                  Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Inventory Impact -->
                <Border Background="White" Padding="15" Margin="0,0,0,20" BorderBrush="#BDC3C7" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Inventory Impact" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Before" Style="{StaticResource LabelStyle}" TextAlignment="Center"/>
                                <TextBlock Text="{Binding QuantityBefore, TargetNullValue='-'}"
                                          FontWeight="Bold"
                                          FontSize="24"
                                          TextAlignment="Center"
                                          Foreground="#95A5A6"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                      Text="→"
                                      FontSize="32"
                                      VerticalAlignment="Center"
                                      Margin="20,0"
                                      Foreground="#BDC3C7"/>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="After" Style="{StaticResource LabelStyle}" TextAlignment="Center"/>
                                <TextBlock Text="{Binding QuantityAfter, TargetNullValue='-'}"
                                          FontWeight="Bold"
                                          FontSize="24"
                                          TextAlignment="Center"
                                          Foreground="#27AE60"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Current Quantity On Hand"
                                  FontSize="11"
                                  Foreground="#7F8C8D"
                                  TextAlignment="Center"
                                  Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Financial Loss Display (for negative adjustments) -->
                <Border Background="#FFEBEE"
                       Padding="15"
                       Margin="0,0,0,20"
                       BorderBrush="#E74C3C"
                       BorderThickness="1"
                       CornerRadius="3"
                       Visibility="{Binding IsLoss, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="💸 Financial Loss" FontWeight="Bold" FontSize="16" Foreground="#C62828" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Quantity Lost:" FontSize="12" Foreground="#666" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding QuantityLost}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cost Lost:" FontSize="12" Foreground="#666" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CostLost, StringFormat=C2, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" Foreground="#E74C3C" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Potential Revenue Lost:" FontSize="12" Foreground="#666" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PotentialRevenueLost, StringFormat=C2, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>

                            <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Potential Profit Lost:" FontWeight="Bold" FontSize="14" Foreground="#C62828"/>
                            <TextBlock Grid.Column="1" Text="{Binding PotentialProfitLost, StringFormat=C2, Mode=OneWay}" FontWeight="Bold" FontSize="16" Foreground="#C62828"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Metadata -->
                <Border Background="White" Padding="15" BorderBrush="#BDC3C7" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Metadata" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="Adjustment ID" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Adjustment.Id}"
                                  Style="{StaticResource ValueStyle}"
                                  FontFamily="Consolas"
                                  FontSize="11"/>

                        <TextBlock Text="Created Date" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Adjustment.CreatedDate, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                  Style="{StaticResource ValueStyle}"
                                  FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="15" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close"
                       Command="{Binding CloseCommand}"
                       Padding="20,10"
                       Margin="0,0,10,0"
                       Background="#95A5A6"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="SemiBold"
                       Cursor="Hand"/>

                <Button Content="Save Changes"
                       Command="{Binding SaveCommand}"
                       Padding="20,10"
                       Background="#27AE60"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="SemiBold"
                       Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
