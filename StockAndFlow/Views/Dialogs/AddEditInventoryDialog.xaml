<Window x:Class="StockAndFlow.Views.Dialogs.AddEditInventoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Item"
        Height="750"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#95A5A6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <TextBlock Text="{Binding DialogTitle}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!-- Name -->
                <TextBlock Text="Name *" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- SKU -->
                <TextBlock Text="SKU" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Category -->
                <TextBlock Text="Category" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Cost Per Unit -->
                <TextBlock Text="Cost Per Unit *" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding CostPerUnit, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>

                <!-- Sale Price -->
                <TextBlock Text="Sale Price *" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>

                <!-- Quantity On Hand -->
                <TextBlock Text="Quantity On Hand *" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding QuantityOnHand, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Minimum Stock Level -->
                <TextBlock Text="Minimum Stock Level" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding MinimumStockLevel, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Supplier -->
                <TextBlock Text="Supplier" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Image -->
                <TextBlock Text="Product Image" Style="{StaticResource LabelStyle}"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True"
                             Background="#ECF0F1"/>
                    <Button Grid.Column="1"
                            Content="Browse..."
                            Command="{Binding BrowseImageCommand}"
                            Margin="5,0,0,0"
                            Padding="15,8"/>
                </Grid>

                <!-- Image Preview -->
                <Border BorderBrush="#BDC3C7"
                        BorderThickness="1"
                        Margin="0,0,0,15"
                        Height="150"
                        Background="White"
                        Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Image Source="{Binding ImagePath}"
                           Stretch="Uniform"
                           Margin="5"/>
                </Border>

                <!-- Notes -->
                <TextBlock Text="Notes" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>

                <!-- Bill of Materials -->
                <Border Background="#EEF2FF"
                        Padding="15"
                        Margin="0,15,0,0"
                        BorderBrush="#7986CB"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Foreground="#3949AB" Margin="0,0,0,4">Bill of Materials</TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="#555" FontSize="11" Margin="0,0,0,10">
                            When this item is sold, stock is also deducted from the components listed below.
                        </TextBlock>

                        <!-- Add row -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AvailableComponents}"
                                      SelectedItem="{Binding PendingComponent}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,5,0"
                                      Padding="6,4"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding PendingQty, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Qty per unit sold"
                                     Margin="0,0,5,0"/>
                            <Button Grid.Column="2"
                                    Content="Add"
                                    Command="{Binding AddBomComponentCommand}"
                                    Padding="6,4"/>
                        </Grid>

                        <!-- Component list -->
                        <ItemsControl ItemsSource="{Binding BomComponents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="24"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Item.Name}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding QuantityDisplay}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,6,0"
                                                   Foreground="#555"/>
                                        <Button Grid.Column="2"
                                                Content="✕"
                                                Command="{Binding RemoveCommand}"
                                                Padding="2"
                                                FontSize="10"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="#E74C3C"
                                                Cursor="Hand"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Calculated Info Display -->
                <Border Background="#E8F5E9"
                        Padding="15"
                        Margin="0,15,0,0"
                        BorderBrush="#81C784"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock FontWeight="Bold"
                                   Foreground="#2E7D32"
                                   Margin="0,0,0,10">Calculated Values:</TextBlock>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Profit per Unit:" FontSize="11" Foreground="#555"/>
                                <TextBlock Text="{Binding ProfitMarginPerUnit, StringFormat=C2}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#2E7D32"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Profit Margin:" FontSize="11" Foreground="#555"/>
                                <TextBlock Text="{Binding ProfitMarginPercentage, StringFormat={}{0:F2}%}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#2E7D32"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#BDC3C7"
                BorderThickness="0,1,0,0"
                Padding="20">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,10,0"
                        Width="100"/>
                <Button Content="Save"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        Width="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
