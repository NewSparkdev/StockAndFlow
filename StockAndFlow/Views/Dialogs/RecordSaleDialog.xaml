<Window x:Class="StockAndFlow.Views.Dialogs.RecordSaleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Sale"
        Height="600"
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#95A5A6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#27AE60" Padding="20">
            <TextBlock Text="Record Sale - Select Items"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- Barcode / SKU scan bar (USB scanner or manual entry) -->
        <Border Grid.Row="1" Margin="20,20,20,4" Background="#EEF6FF" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="4" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍 Scan / SKU:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#1565C0"/>
                <TextBox Grid.Column="1" x:Name="BarcodeSearchBox"
                         BorderBrush="#90CAF9" BorderThickness="1" Padding="6,4"
                         ToolTip="Scan a USB barcode or type a SKU then press Enter"
                         KeyDown="BarcodeSearchBox_KeyDown"/>
                <TextBlock Grid.Column="2" Text="Press Enter to find item" FontSize="11"
                           Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Items List -->
        <Border Grid.Row="2" Margin="20,0,20,10" Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding AllItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#ECF0F1" BorderThickness="0,0,0,1" Padding="15,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox -->
                                    <CheckBox Grid.Column="0"
                                             IsChecked="{Binding IsSelected}"
                                             VerticalAlignment="Center"/>

                                    <!-- Item Name & Details -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ItemName}" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock FontSize="10" Foreground="#7F8C8D">
                                            <Run Text="Available:"/>
                                            <Run Text="{Binding AvailableQuantity}"/>
                                            <Run Text=" | Default Price:"/>
                                            <Run Text="{Binding SalePricePerUnit, StringFormat=C2}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Quantity -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Qty" FontSize="10" Foreground="#7F8C8D" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                Padding="5"
                                                Margin="0"
                                                TextAlignment="Center"
                                                IsEnabled="{Binding IsSelected}"/>
                                    </StackPanel>

                                    <!-- Price -->
                                    <StackPanel Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Price" FontSize="10" Foreground="#7F8C8D" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding SalePricePerUnit, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                Padding="5"
                                                Margin="0"
                                                TextAlignment="Right"
                                                IsEnabled="{Binding IsSelected}"/>
                                    </StackPanel>

                                    <!-- Subtotal -->
                                    <StackPanel Grid.Column="4" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Subtotal" FontSize="10" Foreground="#7F8C8D" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding Subtotal, StringFormat=C2}"
                                                  FontWeight="Bold"
                                                  FontSize="14"
                                                  Foreground="#27AE60"
                                                  TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Customer Info & Summary -->
        <Grid Grid.Row="3" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Customer Info -->
            <Border Grid.Column="0" Background="White" Padding="15" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Customer Information (Optional)" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>

                    <TextBlock Text="Customer Name" Style="{StaticResource LabelStyle}" FontSize="11"/>
                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="Customer Email" Style="{StaticResource LabelStyle}" FontSize="11"/>
                    <TextBox Text="{Binding CustomerEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="Notes" Style="{StaticResource LabelStyle}" FontSize="11"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Height="50"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Sales Tax" Style="{StaticResource LabelStyle}" FontSize="11"/>
                    <ComboBox ItemsSource="{Binding States}"
                             SelectedItem="{Binding SelectedState, UpdateSourceTrigger=PropertyChanged}"
                             DisplayMemberPath="DisplayName"
                             Margin="0"/>
                </StackPanel>
            </Border>

            <!-- Sale Summary -->
            <Border Grid.Column="1"
                    Background="#E8F5E9"
                    Padding="15"
                    BorderBrush="#81C784"
                    BorderThickness="2"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Sale Summary" FontWeight="Bold" FontSize="14" Margin="0,0,0,15" Foreground="#2E7D32"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Items Selected:" FontSize="12" Foreground="#555" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItemCount}" FontWeight="Bold" FontSize="12" Foreground="#2E7D32" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Profit:" FontSize="12" Foreground="#555" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CartTotalProfit, StringFormat=C2}" FontWeight="Bold" FontSize="12" Foreground="#2E7D32" Margin="0,0,0,10"/>

                        <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,5,0,10"/>
                    </Grid>

                    <!-- Tax Breakdown -->
                    <Grid Margin="0,5,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal:" FontSize="12" Foreground="#555" Margin="0,0,0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CartSubtotal, StringFormat=C2}" FontWeight="Bold" FontSize="12" Foreground="#2E7D32" Margin="0,0,0,5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12" Foreground="#555" Margin="0,0,0,5">
                            <Run Text="Tax ("/>
                            <Run Text="{Binding TaxRate, Mode=OneWay, StringFormat={}{0:F2}}"/>
                            <Run Text="%)"/>
                            <Run Text=":"/>
                        </TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TaxAmount, Mode=OneWay, StringFormat=C2}" FontWeight="Bold" FontSize="12" Foreground="#2E7D32" Margin="0,0,0,5"/>

                        <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,5"/>
                    </Grid>

                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Grand Total:" FontSize="14" FontWeight="Bold" Foreground="#27AE60"/>
                        <TextBlock Grid.Column="1" Text="{Binding CartTotal, StringFormat=C2}" FontWeight="Bold" FontSize="20" Foreground="#27AE60"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#BDC3C7"
                BorderThickness="0,1,0,0"
                Padding="20">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,10,0"
                        Width="100"/>
                <Button Content="Record Sale"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        Width="140"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
