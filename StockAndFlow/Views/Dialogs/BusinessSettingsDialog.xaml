<Window x:Class="StockAndFlow.Views.Dialogs.BusinessSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Business Information"
        Width="600"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <Style TargetType="TextBox" x:Key="InputStyle">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#3498DB" Padding="20">
            <StackPanel>
                <TextBlock Text="Business Information"
                          FontSize="20"
                          FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock Text="Enter your business details for invoice generation"
                          FontSize="13"
                          Foreground="#E8F4F8"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- Business Name -->
                <TextBlock Text="Business Name *" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource InputStyle}"/>

                <!-- Address -->
                <TextBlock Text="Street Address" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource InputStyle}"/>

                <!-- City, State, Zip -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="City" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="State" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding State, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Zip Code" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding ZipCode, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Phone -->
                <TextBlock Text="Phone" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource InputStyle}"/>

                <!-- Email -->
                <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource InputStyle}"/>

                <!-- Website -->
                <TextBlock Text="Website" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource InputStyle}"/>

                <!-- Tax ID -->
                <TextBlock Text="Tax ID / EIN" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding TaxId, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource InputStyle}"/>

                <!-- Logo -->
                <TextBlock Text="Business Logo (Optional)" Style="{StaticResource LabelStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                            Text="{Binding LogoPath, Mode=OneWay}"
                            Style="{StaticResource InputStyle}"
                            IsReadOnly="True"/>

                    <Button Grid.Column="2"
                           Content="Browse..."
                           Command="{Binding BrowseLogoCommand}"
                           Padding="15,8"
                           Background="#95A5A6"
                           Foreground="White"
                           BorderThickness="0"
                           Cursor="Hand"/>
                </Grid>

                <!-- Invoice display choices -->
                <TextBlock Text="What appears on your invoices" Style="{StaticResource LabelStyle}" Margin="0,20,0,5"/>
                <TextBlock Text="Only filled-in details can appear. Your business name and address always show."
                          FontSize="11"
                          Foreground="#7F8C8D"
                          TextWrapping="Wrap"
                          Margin="0,0,0,8"/>
                <CheckBox Content="Logo" IsChecked="{Binding ShowLogoOnInvoice}" Margin="0,0,0,4"/>
                <CheckBox Content="Phone" IsChecked="{Binding ShowPhoneOnInvoice}" Margin="0,0,0,4"/>
                <CheckBox Content="Email" IsChecked="{Binding ShowEmailOnInvoice}" Margin="0,0,0,4"/>
                <CheckBox Content="Website" IsChecked="{Binding ShowWebsiteOnInvoice}" Margin="0,0,0,4"/>
                <CheckBox Content="Tax ID" IsChecked="{Binding ShowTaxIdOnInvoice}" Margin="0,0,0,4"/>

                <TextBlock Text="* Required field"
                          FontSize="12"
                          Foreground="#7F8C8D"
                          Margin="0,20,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="15" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                       Command="{Binding CancelCommand}"
                       Padding="20,10"
                       Margin="0,0,10,0"
                       Background="#95A5A6"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="SemiBold"
                       Cursor="Hand"/>

                <Button Content="Save"
                       Command="{Binding SaveCommand}"
                       Padding="20,10"
                       Background="#27AE60"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="SemiBold"
                       Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="{Binding IsValid}"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
