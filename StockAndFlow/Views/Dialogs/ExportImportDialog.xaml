<Window x:Class="StockAndFlow.Views.Dialogs.ExportImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export/Import Data"
        Width="500"
        Height="400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Export or Import Data"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,30"/>

        <!-- Options -->
        <StackPanel Grid.Row="1">
            <!-- Export Option -->
            <Border Background="White"
                   Padding="20"
                   BorderBrush="#27AE60"
                   BorderThickness="2"
                   CornerRadius="5"
                   Cursor="Hand"
                   MouseDown="ExportOption_Click">
                <StackPanel>
                    <TextBlock Text="📥 Export to Excel"
                              FontSize="18"
                              FontWeight="Bold"
                              Foreground="#27AE60"
                              Margin="0,0,0,10"/>
                    <TextBlock Text="Export all your data to an Excel file"
                              FontSize="12"
                              Foreground="#7F8C8D"
                              TextWrapping="Wrap"
                              Margin="0,0,0,5"/>
                    <TextBlock Text="• Edit data offline"
                              FontSize="11"
                              Foreground="#95A5A6"
                              Margin="0,0,0,2"/>
                    <TextBlock Text="• Add sales, expenses, inventory away from your computer"
                              FontSize="11"
                              Foreground="#95A5A6"
                              Margin="0,0,0,2"/>
                    <TextBlock Text="• All formulas included for automatic calculations"
                              FontSize="11"
                              Foreground="#95A5A6"/>
                </StackPanel>
            </Border>

            <!-- Import Option -->
            <Border Background="White"
                   Padding="20"
                   BorderBrush="#3498DB"
                   BorderThickness="2"
                   CornerRadius="5"
                   Cursor="Hand"
                   Margin="0,20,0,0"
                   MouseDown="ImportOption_Click">
                <StackPanel>
                    <TextBlock Text="📤 Import from Excel"
                              FontSize="18"
                              FontWeight="Bold"
                              Foreground="#3498DB"
                              Margin="0,0,0,10"/>
                    <TextBlock Text="Import data from a previously exported Excel file"
                              FontSize="12"
                              Foreground="#7F8C8D"
                              TextWrapping="Wrap"
                              Margin="0,0,0,5"/>
                    <TextBlock Text="• Updates inventory, sales, and expenses"
                              FontSize="11"
                              Foreground="#95A5A6"
                              Margin="0,0,0,2"/>
                    <TextBlock Text="• Validates data before importing"
                              FontSize="11"
                              Foreground="#95A5A6"
                              Margin="0,0,0,2"/>
                    <TextBlock Text="• Warns if file was previously imported"
                              FontSize="11"
                              Foreground="#95A5A6"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Cancel Button -->
        <Button Grid.Row="2"
               Content="Cancel"
               Click="CancelButton_Click"
               Padding="20,10"
               Background="#95A5A6"
               Foreground="White"
               BorderThickness="0"
               FontWeight="SemiBold"
               Cursor="Hand"
               HorizontalAlignment="Center"
               Margin="0,20,0,0"/>
    </Grid>
</Window>
