<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockAndFlow.Mobile.MainPage">

    <ScrollView>
        <!-- Adaptive: fills on phone, centers with a max width on desktop/tablet -->
        <VerticalStackLayout Padding="16" Spacing="16"
                             MaximumWidthRequest="860" HorizontalOptions="Fill">

            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Business overview" Style="{StaticResource PageTitle}" />
                    <Label Text="{Binding StatusMessage}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
                <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" VerticalOptions="Center" />
            </Grid>

            <!-- Date range -->
            <Border Style="{StaticResource Card}" Padding="14">
                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                    <Label Text="From" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    <DatePicker Grid.Column="1" Date="{Binding StartDate}" />
                    <Label Grid.Column="2" Text="To" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    <DatePicker Grid.Column="3" Date="{Binding EndDate}" />
                </Grid>
            </Border>

            <!-- Metric tiles -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12" RowSpacing="12"
                  BindingContext="{Binding CurrentMetrics}">

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Total Revenue" Style="{StaticResource Caption}" />
                        <Label Text="{Binding TotalRevenue, StringFormat='{0:C2}'}" Style="{StaticResource MetricValue}" TextColor="{StaticResource Success}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Net Profit" Style="{StaticResource Caption}" />
                        <Label Text="{Binding NetProfit, StringFormat='{0:C2}'}" Style="{StaticResource MetricValue}" TextColor="{StaticResource Primary}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Gross Profit" Style="{StaticResource Caption}" />
                        <Label Text="{Binding GrossProfit, StringFormat='{0:C2}'}" Style="{StaticResource MetricValue}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Total Expenses" Style="{StaticResource Caption}" />
                        <Label Text="{Binding TotalExpenses, StringFormat='{0:C2}'}" Style="{StaticResource MetricValue}" TextColor="{StaticResource Danger}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Inventory Value" Style="{StaticResource Caption}" />
                        <Label Text="{Binding TotalInventoryValue, StringFormat='{0:C2}'}" Style="{StaticResource MetricValue}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Sales Count" Style="{StaticResource Caption}" />
                        <Label Text="{Binding TotalSalesCount}" Style="{StaticResource MetricValue}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Button Text="Refresh" Command="{Binding RefreshMetricsCommand}" />

            <!-- Business logo (set in Settings > Business Settings) -->
            <Image Source="{Binding LogoPath, Converter={StaticResource ImagePathConverter}}"
                   IsVisible="{Binding HasLogo}"
                   HeightRequest="140" Aspect="AspectFit"
                   Margin="0,16,0,0" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
