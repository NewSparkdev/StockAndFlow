<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockAndFlow.Mobile.Pages.ExportImportPage"
             Title="Export / Import">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Export your data to an Excel file you can back up or share, or import data from a previously exported file."
                   TextColor="Gray" />

            <Border Stroke="#512BD4" StrokeThickness="1" Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Export" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Saves an .xlsx to your Downloads folder (in a &quot;Stock &amp; Flow&quot; folder), with the option to share a copy." TextColor="Gray" FontSize="13" />
                    <Button x:Name="ExportButton" Text="Export to Excel" Clicked="OnExportClicked" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#512BD4" StrokeThickness="1" Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Import" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Pick a previously exported .xlsx file to import." TextColor="Gray" FontSize="13" />
                    <Label Text="This opens your phone's file browser. Tap the ☰ menu, go to Downloads › Stock &amp; Flow to find your export. Press Back to cancel and return here."
                           TextColor="Gray" FontSize="12" />
                    <Button x:Name="ImportButton" Text="Import from Excel" Clicked="OnImportClicked" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" />

            <Button Text="Close" BackgroundColor="#95A5A6" Clicked="OnCloseClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
