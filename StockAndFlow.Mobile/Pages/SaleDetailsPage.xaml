<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:StockAndFlow.Models;assembly=StockAndFlow.Core"
             x:Class="StockAndFlow.Mobile.Pages.SaleDetailsPage"
             Title="Sale Details">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10" MaximumWidthRequest="720" HorizontalOptions="Center">

            <Label Text="{Binding Transaction.ItemSummary}" FontSize="20" FontAttributes="Bold" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Revenue" />
                <Label Grid.Column="1" Text="{Binding Transaction.Revenue, StringFormat='{0:C2}'}" FontAttributes="Bold" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="COGS" />
                <Label Grid.Column="1" Text="{Binding Transaction.COGS, StringFormat='{0:C2}'}" FontAttributes="Bold" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Profit" />
                <Label Grid.Column="1" Text="{Binding Transaction.Profit, StringFormat='{0:C2}'}" FontAttributes="Bold" />
            </Grid>

            <Label Text="Date" />
            <DatePicker Date="{Binding SaleDate}" />

            <Label Text="Customer" />
            <Label Text="{Binding Transaction.CustomerName}" />

            <Label Text="Items" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Transaction.Items}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Sale">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{Binding ItemName}" />
                            <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" />
                            <Label Grid.Column="2" Text="{Binding Revenue, StringFormat='{0:C2}'}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                <Button Grid.Column="0" Text="Close" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="1" Text="Save Date" Command="{Binding SaveCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
