<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:beh="clr-namespace:StockAndFlow.Mobile.Behaviors"
             xmlns:ctrl="clr-namespace:StockAndFlow.Mobile.Controls"
             x:Class="StockAndFlow.Mobile.Pages.AddEditInventoryPage"
             Title="{Binding DialogTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="720" HorizontalOptions="Center">

            <Label Text="Name" />
            <Entry Text="{Binding Name}" Placeholder="Item name" />

            <Label Text="SKU / Barcode" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Text="{Binding Sku}" Placeholder="Optional — or scan →" />
                <Button Grid.Column="1" Text="📷 Scan" x:Name="ScanSkuButton" WidthRequest="90" />
            </Grid>
            <HorizontalStackLayout Spacing="8">
                <Button Text="🏷  Create barcode label" x:Name="MakeBarcodeButton" />
                <ctrl:HelpIcon HelpTitle="Which barcode do I need?"
                               HelpText="{Binding BarcodeHelpText}"
                               VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label Text="Makes a printable barcode for your own labels — great for markets, craft fairs and your own shop. Selling through a retailer or Amazon? Scan or type their official barcode above instead."
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />

            <Label Text="Category" />
            <Entry Text="{Binding Category}" Placeholder="Optional" />

            <HorizontalStackLayout Spacing="6">
                <Label Text="How do you measure this item?" VerticalOptions="Center" />
                <ctrl:HelpIcon HelpTitle="How do you measure this item?"
                               HelpText="{Binding MeasureHelpText}" />
            </HorizontalStackLayout>
            <Picker ItemsSource="{Binding UnitOptions}"
                    SelectedItem="{Binding SelectedUnit}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding CostLabel}" VerticalOptions="Center" />
                        <ctrl:HelpIcon HelpTitle="{Binding CostLabel}"
                                       HelpText="{Binding CostHelpText}" />
                    </HorizontalStackLayout>
                    <Entry Text="{Binding CostPerUnit}" Keyboard="Numeric" IsReadOnly="{Binding HasBom}">
                        <Entry.Behaviors>
                            <beh:NumericEntryBehavior AllowDecimal="True" AllowNegative="False" />
                        </Entry.Behaviors>
                    </Entry>
                    <Label Text="{Binding CostBreakdownHint}"
                           IsVisible="{Binding HasBom}"
                           FontSize="11" TextColor="#3949AB" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding PriceLabel}" VerticalOptions="Center" />
                        <ctrl:HelpIcon HelpTitle="{Binding PriceLabel}"
                                       HelpText="{Binding PriceHelpText}" />
                    </HorizontalStackLayout>
                    <Entry Text="{Binding SalePrice}" Keyboard="Numeric">
                        <Entry.Behaviors>
                            <beh:NumericEntryBehavior AllowDecimal="True" AllowNegative="False" />
                        </Entry.Behaviors>
                    </Entry>
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding QuantityLabel}" VerticalOptions="Center" />
                        <ctrl:HelpIcon HelpTitle="{Binding QuantityLabel}"
                                       HelpText="{Binding QuantityHelpText}" />
                    </HorizontalStackLayout>
                    <Entry Text="{Binding QuantityOnHand}" Keyboard="Numeric">
                        <Entry.Behaviors>
                            <beh:NumericEntryBehavior AllowDecimal="True" AllowNegative="False" />
                        </Entry.Behaviors>
                    </Entry>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding MinStockLabel}" VerticalOptions="Center" />
                        <ctrl:HelpIcon HelpTitle="{Binding MinStockLabel}"
                                       HelpText="{Binding MinStockHelpText}" />
                    </HorizontalStackLayout>
                    <Entry Text="{Binding MinimumStockLevel}" Keyboard="Numeric">
                        <Entry.Behaviors>
                            <beh:NumericEntryBehavior AllowDecimal="True" AllowNegative="False" />
                        </Entry.Behaviors>
                    </Entry>
                </VerticalStackLayout>
            </Grid>

            <Label Text="{Binding ProfitSummary}" TextColor="Gray" />

            <Label Text="Supplier" />
            <Entry Text="{Binding Supplier}" Placeholder="Optional" />

            <Label Text="Notes" />
            <Editor Text="{Binding Notes}" HeightRequest="80" />

            <Button Text="Choose Image" Command="{Binding BrowseImageCommand}" />
            <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}" IsVisible="{Binding HasImage}" HeightRequest="120" Aspect="AspectFit" />

            <!-- Bill of Materials -->
            <Frame Padding="12" BackgroundColor="#EEF2FF" BorderColor="#7986CB" CornerRadius="6" Margin="0,8,0,0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Bill of Materials" FontAttributes="Bold" TextColor="#3949AB" />
                    <Label Text="When this item is sold, stock is also deducted from the components below."
                           FontSize="12" TextColor="#555" />

                    <!-- Add component row -->
                    <Grid ColumnDefinitions="*,70,Auto" ColumnSpacing="6">
                        <Picker Grid.Column="0"
                                Title="Select component"
                                ItemsSource="{Binding AvailableComponents}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding PendingComponent}" />
                        <Entry Grid.Column="1"
                               Text="{Binding PendingQty}"
                               Keyboard="Numeric"
                               Placeholder="Qty" />
                        <Button Grid.Column="2"
                                Text="Add"
                                Command="{Binding AddBomComponentCommand}"
                                WidthRequest="60" />
                    </Grid>

                    <!-- Cost breakdown (feeds the "Your cost" field above) -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding HasBom}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Materials cost per item" FontAttributes="Bold" TextColor="#3949AB" />
                            <Label Grid.Column="1" Text="{Binding MaterialsCost, StringFormat='{0:C2}'}" FontAttributes="Bold" TextColor="#3949AB" />
                        </Grid>
                        <Grid ColumnDefinitions="*,90" ColumnSpacing="8">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="Extra costs per item (labor, packaging)" VerticalOptions="Center" />
                                <ctrl:HelpIcon HelpTitle="Extra costs per item"
                                               HelpText="{Binding ExtraCostHelpText}" />
                            </HorizontalStackLayout>
                            <Entry Grid.Column="1" Text="{Binding ExtraCost}" Keyboard="Numeric" HorizontalTextAlignment="End">
                                <Entry.Behaviors>
                                    <beh:NumericEntryBehavior AllowDecimal="True" AllowNegative="False" />
                                </Entry.Behaviors>
                            </Entry>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Your cost per item" FontAttributes="Bold" TextColor="#3949AB" />
                            <Label Grid.Column="1" Text="{Binding CostPerUnit, StringFormat='{0:C2}'}" FontAttributes="Bold" TextColor="#3949AB" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Component list -->
                    <CollectionView ItemsSource="{Binding BomComponents}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="0,4" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Item.Name}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding QuantityDisplay}" TextColor="#3949AB" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding LineCostDisplay}" TextColor="#555" FontSize="13" VerticalOptions="Center" />
                                    <Button Grid.Column="3" Text="✕" Command="{Binding RemoveCommand}"
                                            TextColor="#E74C3C" BackgroundColor="Transparent"
                                            WidthRequest="36" HeightRequest="36" Padding="0" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                <Button Grid.Column="0" Text="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="1" Text="Save" Command="{Binding SaveCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
