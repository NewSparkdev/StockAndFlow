<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:beh="clr-namespace:StockAndFlow.Mobile.Behaviors"
             x:Class="StockAndFlow.Mobile.Pages.AddEditInventoryPage"
             Title="{Binding DialogTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="720" HorizontalOptions="Fill">

            <Label Text="Name" />
            <Entry Text="{Binding Name}" Placeholder="Item name" />

            <Label Text="SKU / Barcode" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Text="{Binding Sku}" Placeholder="Optional — or scan →" />
                <Button Grid.Column="1" Text="📷 Scan" x:Name="ScanSkuButton" WidthRequest="90" />
            </Grid>

            <Label Text="Category" />
            <Entry Text="{Binding Category}" Placeholder="Optional" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Cost / unit" />
                    <Entry Text="{Binding CostPerUnit}" Keyboard="Numeric">
                        <Entry.Behaviors>
                            <beh:NumericEntryBehavior AllowDecimal="True" AllowNegative="False" />
                        </Entry.Behaviors>
                    </Entry>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Sale price" />
                    <Entry Text="{Binding SalePrice}" Keyboard="Numeric">
                        <Entry.Behaviors>
                            <beh:NumericEntryBehavior AllowDecimal="True" AllowNegative="False" />
                        </Entry.Behaviors>
                    </Entry>
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Quantity on hand" />
                    <Entry Text="{Binding QuantityOnHand}" Keyboard="Numeric">
                        <Entry.Behaviors>
                            <beh:NumericEntryBehavior AllowDecimal="False" AllowNegative="False" />
                        </Entry.Behaviors>
                    </Entry>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Min. stock level" />
                    <Entry Text="{Binding MinimumStockLevel}" Keyboard="Numeric">
                        <Entry.Behaviors>
                            <beh:NumericEntryBehavior AllowDecimal="False" AllowNegative="False" />
                        </Entry.Behaviors>
                    </Entry>
                </VerticalStackLayout>
            </Grid>

            <Label Text="{Binding ProfitMarginPerUnit, StringFormat='Profit / unit: {0:C2}'}" TextColor="Gray" />

            <Label Text="Supplier" />
            <Entry Text="{Binding Supplier}" Placeholder="Optional" />

            <Label Text="Notes" />
            <Editor Text="{Binding Notes}" HeightRequest="80" />

            <Button Text="Choose Image" Command="{Binding BrowseImageCommand}" />
            <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}" IsVisible="{Binding HasImage}" HeightRequest="120" Aspect="AspectFit" />

            <!-- Bill of Materials -->
            <Frame Padding="12" BackgroundColor="#EEF2FF" BorderColor="#7986CB" CornerRadius="6" Margin="0,8,0,0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Bill of Materials" FontAttributes="Bold" TextColor="#3949AB" />
                    <Label Text="When this item is sold, stock is also deducted from the components below."
                           FontSize="12" TextColor="#555" />

                    <!-- Add component row -->
                    <Grid ColumnDefinitions="*,70,Auto" ColumnSpacing="6">
                        <Picker Grid.Column="0"
                                Title="Select component"
                                ItemsSource="{Binding AvailableComponents}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding PendingComponent}" />
                        <Entry Grid.Column="1"
                               Text="{Binding PendingQty}"
                               Keyboard="Numeric"
                               Placeholder="Qty" />
                        <Button Grid.Column="2"
                                Text="Add"
                                Command="{Binding AddBomComponentCommand}"
                                WidthRequest="60" />
                    </Grid>

                    <!-- Component list -->
                    <CollectionView ItemsSource="{Binding BomComponents}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,4" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Item.Name}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding QuantityDisplay}" TextColor="#3949AB" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Button Grid.Column="2" Text="✕" Command="{Binding RemoveCommand}"
                                            TextColor="#E74C3C" BackgroundColor="Transparent"
                                            WidthRequest="36" HeightRequest="36" Padding="0" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                <Button Grid.Column="0" Text="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="1" Text="Save" Command="{Binding SaveCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
