<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:StockAndFlow.Models;assembly=StockAndFlow.Core"
             x:Class="StockAndFlow.Mobile.Pages.SalesPage">

    <Grid RowDefinitions="Auto,*" Padding="10" RowSpacing="8" MaximumWidthRequest="900" HorizontalOptions="Fill">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" Padding="0,0,0,8">
            <Label Text="From" VerticalOptions="Center"/>
            <DatePicker Grid.Column="1" Date="{Binding StartDate}"/>
            <Label Grid.Column="2" Text="To" VerticalOptions="Center"/>
            <DatePicker Grid.Column="3" Date="{Binding EndDate}"/>
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsLoading}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Sales}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No sales recorded yet."
                           HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SaleTransaction">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete" BackgroundColor="{StaticResource Danger}" Invoked="OnDeleteSwipe" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Style="{StaticResource ListCard}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRowTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding ItemSummary}"
                                           FontSize="16" FontAttributes="Bold" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           FontAttributes="Bold"
                                           Text="{Binding Revenue, StringFormat='{0:C2}'}" />
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Style="{StaticResource Caption}"
                                           Text="{Binding SaleDate, StringFormat='{0:d}'}" />
                                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           FontSize="13"
                                           Text="{Binding CustomerName}" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentView>
