<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:StockAndFlow.Models;assembly=StockAndFlow.Core"
             xmlns:beh="clr-namespace:StockAndFlow.Mobile.Behaviors"
             x:Class="StockAndFlow.Mobile.Pages.RecordSalePage"
             Title="Record Sale">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="12">

                <Label Text="Customer name" />
                <Entry Text="{Binding CustomerName}" Placeholder="Optional" />

                <Label Text="Customer email" />
                <Entry Text="{Binding CustomerEmail}" Keyboard="Email" Placeholder="Optional" />

                <Label Text="Sales tax (state)" />
                <Picker ItemsSource="{Binding States}"
                        SelectedItem="{Binding SelectedState}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        Title="Select tax state" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                    <Label Text="Items" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="📷 Scan item" x:Name="ScanItemButton"
                            FontSize="13" HeightRequest="36" Padding="10,0" />
                </Grid>
                <CollectionView ItemsSource="{Binding AllItems}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CartItem">
                            <Border Padding="10" Margin="0,4" StrokeThickness="1" Stroke="#E0E0E0"
                                    StrokeShape="RoundRectangle 10">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                    <CheckBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                              IsChecked="{Binding IsSelected}" VerticalOptions="Center" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding ItemName}" FontAttributes="Bold" />
                                    <Label Grid.Row="1" Grid.Column="1" Style="{StaticResource Caption}"
                                           Text="{Binding SalePricePerUnit, StringFormat='{0:C2} ea'}" />
                                    <Label Grid.Row="2" Grid.Column="1" Style="{StaticResource Caption}"
                                           Text="{Binding AvailableQuantity, StringFormat='{0} in stock'}" />
                                    <Entry Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                                           Text="{Binding Quantity}" Keyboard="Numeric"
                                           WidthRequest="60" HorizontalTextAlignment="Center"
                                           VerticalOptions="Center">
                                        <Entry.Behaviors>
                                            <beh:NumericEntryBehavior AllowDecimal="False" AllowNegative="False" />
                                        </Entry.Behaviors>
                                    </Entry>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Notes" />
                <Editor Text="{Binding Notes}" HeightRequest="70" />

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="6" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Subtotal" />
                <Label Grid.Column="1" Text="{Binding CartSubtotal, StringFormat='{0:C2}'}" FontAttributes="Bold" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Tax" />
                <Label Grid.Column="1" Text="{Binding TaxAmount, StringFormat='{0:C2}'}" FontAttributes="Bold" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Total" FontSize="18" FontAttributes="Bold" />
                <Label Grid.Column="1" Text="{Binding CartTotal, StringFormat='{0:C2}'}" FontSize="18" FontAttributes="Bold" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,6,0,0">
                <Button Grid.Column="0" Text="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="1" Text="Complete Sale" Command="{Binding SaveCommand}" />
            </Grid>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
