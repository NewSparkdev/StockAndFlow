<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockAndFlow.Mobile.Pages.ExpenseDetailsPage"
             Title="Expense Details">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10" MaximumWidthRequest="720" HorizontalOptions="Center">

            <Label Text="{Binding Expense.Category}" FontSize="20" FontAttributes="Bold" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Amount" />
                <Label Grid.Column="1" Text="{Binding Expense.Amount, StringFormat='{0:C2}'}" FontAttributes="Bold" />
            </Grid>

            <Label Text="Date" />
            <DatePicker Date="{Binding ExpenseDate}" />

            <Label Text="Description" />
            <Label Text="{Binding Expense.Description}" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Linked item" />
                <Label Grid.Column="1" Text="{Binding Expense.LinkedItemName}" FontAttributes="Bold" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Close" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="1" Text="Save Date" Command="{Binding SaveCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
