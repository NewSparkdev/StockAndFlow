<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockAndFlow.Mobile.Pages.PaywallPage"
             Title="Stock &amp; Flow Pro"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">

    <ContentPage.Resources>
        <Style x:Key="PlanCard" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#DDD, Dark=#444}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceContainerDark}}" />
        </Style>
        <Style x:Key="Cell" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="720" HorizontalOptions="Fill">

                <!-- Pitch -->
                <Label Text="{Binding Headline}" FontSize="26" FontAttributes="Bold" />
                <Label Text="{Binding SubHeadline}" FontSize="15"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />

                <!-- Plans -->
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Plans}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PlanCard}">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                           FontSize="17" FontAttributes="Bold" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Badge}"
                                           FontSize="11" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Center" />
                                    <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Price}" FontSize="22" FontAttributes="Bold" />
                                        <Label Text="{Binding PricePeriod}" FontSize="13" VerticalOptions="End"
                                               Margin="0,0,0,3"
                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                    </HorizontalStackLayout>
                                    <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Note}" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPlanTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding SelectedPlan.Name, StringFormat='Selected: {0}'}"
                       FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />

                <!-- Comparison -->
                <Label Text="What you get" FontSize="17" FontAttributes="Bold" Margin="0,10,0,0" />
                <Border Style="{StaticResource PlanCard}">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="*,80,80" Padding="0,0,0,6">
                            <Label Text="" />
                            <Label Grid.Column="1" Text="Free" FontAttributes="Bold" FontSize="12"
                                   HorizontalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="Pro" FontAttributes="Bold" FontSize="12"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource Primary}" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Comparison}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,80,80" Padding="0,7">
                                        <Label Text="{Binding Feature}" Style="{StaticResource Cell}" />
                                        <Label Grid.Column="1" Text="{Binding Free}" Style="{StaticResource Cell}"
                                               HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="2" Text="{Binding Pro}" Style="{StaticResource Cell}"
                                               HorizontalTextAlignment="Center" FontAttributes="Bold" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding PrivacyNote}" FontSize="12" Margin="0,4,0,0"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />

                <!-- Shown until store billing is switched on -->
                <Label Text="{Binding PurchaseUnavailableNote}" FontSize="12"
                       IsVisible="{Binding ShowPurchaseUnavailableNote}"
                       TextColor="#B36B00" />

                <Label Text="{Binding StatusMessage}" FontSize="13" TextColor="#B00020" />

                <Button Text="Restore a purchase" Command="{Binding RestoreCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,4,0,0" />
                <Label Text="Already bought Pro? Restore brings it back on this device — no account needed."
                       FontSize="11"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Pinned buy bar -->
        <VerticalStackLayout Grid.Row="1" Padding="16,10" Spacing="6"
                             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="{Binding BuyButtonText}" Command="{Binding PurchaseCommand}" />
            <Button Text="Not now" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
