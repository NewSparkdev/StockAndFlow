<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:StockAndFlow.Models;assembly=StockAndFlow.Core"
             x:Class="StockAndFlow.Mobile.Pages.AdjustmentsPage"
             Title="Adjustments">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Record" Command="{Binding RecordAdjustmentCommand}" />
        <ToolbarItem Text="Refresh" Command="{Binding RefreshCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="10" RowSpacing="8" MaximumWidthRequest="900" HorizontalOptions="Center">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" Padding="0,0,0,8">
            <Label Text="From" VerticalOptions="Center"/>
            <DatePicker Grid.Column="1" Date="{Binding StartDate}"/>
            <Label Grid.Column="2" Text="To" VerticalOptions="Center"/>
            <DatePicker Grid.Column="3" Date="{Binding EndDate}"/>
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsLoading}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Adjustments}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedAdjustment}">
                <CollectionView.EmptyView>
                    <Label Text="No adjustments recorded yet."
                           HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:InventoryAdjustment">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete" BackgroundColor="{StaticResource Danger}" Invoked="OnDeleteSwipe" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Style="{StaticResource ListCard}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRowTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding InventoryItemName}"
                                           FontSize="16" FontAttributes="Bold" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding QuantityChangeDisplay}"
                                           FontAttributes="Bold"
                                           TextColor="{Binding QuantityChangeColor}" />
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Style="{StaticResource Caption}"
                                           Text="{Binding ReasonDisplay}" />
                                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           FontSize="13"
                                           Text="{Binding AdjustmentDate, StringFormat='{0:d}'}" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
