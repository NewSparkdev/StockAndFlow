<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:StockAndFlow.Mobile.Controls"
             x:Class="StockAndFlow.Mobile.Pages.ShopifySettingsPage"
             Title="Shopify Sync"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">

    <ContentPage.Resources>
        <Style x:Key="FieldLabel" TargetType="Label" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="2,0,0,2" />
        </Style>
        <Style x:Key="FieldEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceContainerDark}}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="16" MaximumWidthRequest="720" HorizontalOptions="Fill">

                <!-- Connection -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Connect your Shopify store" Style="{StaticResource SectionTitle}" />
                        <Label Text="Pulls your products and orders into Stock &amp; Flow, and can push inventory counts back to Shopify."
                               Style="{StaticResource Caption}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Enable Shopify sync" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ShopifyEnabled}" />
                        </Grid>

                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="Store name" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <ctrl:HelpIcon HelpTitle="Store name" HelpText="{Binding StoreNameHelpText}" />
                            </HorizontalStackLayout>
                            <Entry Text="{Binding StoreName}" Placeholder="yourstore" Keyboard="Url" Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="Admin API access token" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <ctrl:HelpIcon HelpTitle="Access token" HelpText="{Binding AccessTokenHelpText}" />
                            </HorizontalStackLayout>
                            <Entry Text="{Binding AccessToken}" Placeholder="shpat_..." IsPassword="True" Style="{StaticResource FieldEntry}" />
                            <Label Text="Stored encrypted on this device only." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Stock counts -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Stock counts" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                            <ctrl:HelpIcon HelpTitle="Who keeps the stock count?"
                                           HelpText="{Binding StockOwnershipHelpText}" />
                        </HorizontalStackLayout>
                        <Label Text="Stock &amp; Flow keeps the real count — it's the only place that sees your market and craft-fair sales too. Syncing brings online orders in; it never overwrites your counts."
                               Style="{StaticResource Caption}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="Send my stock counts to Shopify" />
                                <Label Text="Keeps your storefront from selling what you already sold in person."
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding PushStockLevels}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Actions -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Test &amp; sync" Style="{StaticResource SectionTitle}" />

                        <Button Text="Test Connection" Command="{Binding TestConnectionCommand}"
                                Style="{StaticResource SecondaryButton}" />
                        <Button Text="Sync Now" Command="{Binding SyncNowCommand}" />

                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                        <Label Text="{Binding StatusMessage}" Style="{StaticResource Caption}" />

                        <BoxView HeightRequest="1" Color="#DDD" Margin="0,4" />
                        <Label Text="Did a stock-take in Shopify's admin? This replaces your counts with theirs — it asks first."
                               Style="{StaticResource Caption}" />
                        <Button Text="Use Shopify's stock counts"
                                Command="{Binding AdoptShopifyStockCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Pinned action bar -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="16,10"
              BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <Button Grid.Column="0" Text="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Grid.Column="1" Text="Save" Command="{Binding SaveCommand}" />
        </Grid>

    </Grid>

</ContentPage>
