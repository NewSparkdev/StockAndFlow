<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockAndFlow.Mobile.Pages.InventoryDetailsPage"
             Title="Item Details">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Edit" Clicked="OnEditClicked" />
        <ToolbarItem Text="Close" Clicked="OnCloseClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10" MaximumWidthRequest="720" HorizontalOptions="Fill">

            <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}" IsVisible="{Binding HasImage}" HeightRequest="160" Aspect="AspectFit" />

            <Label Text="{Binding Name}" FontSize="24" FontAttributes="Bold" />
            <Label Text="{Binding StockStatus}" FontAttributes="Bold" TextColor="{Binding StockStatusColor}" />

            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasSku}"><Label Text="SKU" /><Label Grid.Column="1" Text="{Binding Sku}" FontAttributes="Bold" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><Label Text="Category" /><Label Grid.Column="1" Text="{Binding Category}" FontAttributes="Bold" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><Label Text="Quantity on hand" /><Label Grid.Column="1" Text="{Binding QuantityOnHand}" FontAttributes="Bold" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><Label Text="Minimum stock level" /><Label Grid.Column="1" Text="{Binding MinimumStockLevel}" FontAttributes="Bold" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><Label Text="Cost / unit" /><Label Grid.Column="1" Text="{Binding CostPerUnit, StringFormat='{0:C2}'}" FontAttributes="Bold" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><Label Text="Sale price" /><Label Grid.Column="1" Text="{Binding SalePrice, StringFormat='{0:C2}'}" FontAttributes="Bold" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><Label Text="Profit / unit" /><Label Grid.Column="1" Text="{Binding ProfitPerUnit, StringFormat='{0:C2}'}" FontAttributes="Bold" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><Label Text="Total value" /><Label Grid.Column="1" Text="{Binding TotalValue, StringFormat='{0:C2}'}" FontAttributes="Bold" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><Label Text="Supplier" /><Label Grid.Column="1" Text="{Binding Supplier}" FontAttributes="Bold" /></Grid>

            <Label Text="Notes" Margin="0,8,0,0" />
            <Label Text="{Binding Notes}" />

            <!-- Bill of Materials (populated from code-behind on appear) -->
            <VerticalStackLayout x:Name="BomSection" IsVisible="False" Spacing="6" Margin="0,8,0,0">
                <Label Text="Bill of Materials" FontAttributes="Bold" FontSize="16" />
                <Label Text="Components consumed per unit sold:" TextColor="Gray" FontSize="12" />
                <CollectionView x:Name="BomList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                                <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding QuantityDisplay}" TextColor="#3949AB" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
                <Button Grid.Column="0" Text="Edit" Clicked="OnEditClicked" />
                <Button Grid.Column="1" Text="Close" Clicked="OnCloseClicked" Style="{StaticResource SecondaryButton}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
