<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:StockAndFlow.Models;assembly=StockAndFlow.Core"
             x:Class="StockAndFlow.Mobile.Pages.InventoryPage">

    <Grid RowDefinitions="Auto,Auto,*" Padding="10" RowSpacing="8" MaximumWidthRequest="900" HorizontalOptions="Fill">

        <SearchBar Grid.Row="0" Placeholder="Search items..." Text="{Binding SearchText}" />

        <Label Grid.Row="1"
               Text="{Binding LowStockCount, StringFormat='⚠ {0} item(s) low or out of stock'}"
               IsVisible="{Binding HasLowStock}"
               TextColor="{StaticResource Warning}" FontAttributes="Bold" Padding="4,0" />

        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No inventory items yet. Tap Add to create one."
                           HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:InventoryItem">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Edit" BackgroundColor="{StaticResource Primary}" Invoked="OnEditSwipe" />
                                    <SwipeItem Text="Delete" BackgroundColor="{StaticResource Danger}" Invoked="OnDeleteSwipe" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Style="{StaticResource ListCard}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRowTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                           FontSize="16" FontAttributes="Bold" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding StockStatus}"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="{Binding StockStatusColor}" />
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Style="{StaticResource Caption}"
                                           Text="{Binding Sku, StringFormat='SKU: {0}'}" />
                                    <Label Grid.Row="2" Grid.Column="0"
                                           FontSize="13"
                                           Text="{Binding QuantityDisplay, StringFormat='In stock: {0}'}" />
                                    <Label Grid.Row="2" Grid.Column="1"
                                           FontSize="13" FontAttributes="Bold"
                                           Text="{Binding SalePrice, StringFormat='{0:C2}'}" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentView>
