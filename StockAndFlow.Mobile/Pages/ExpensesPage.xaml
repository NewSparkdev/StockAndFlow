<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:StockAndFlow.Models;assembly=StockAndFlow.Core"
             x:Class="StockAndFlow.Mobile.Pages.ExpensesPage"
             Title="Expenses">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Command="{Binding AddExpenseCommand}" />
        <ToolbarItem Text="Refresh" Command="{Binding RefreshCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto" Padding="10" RowSpacing="8">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" Padding="0,0,0,8">
            <Label Text="From" VerticalOptions="Center"/>
            <DatePicker Grid.Column="1" Date="{Binding StartDate}"/>
            <Label Grid.Column="2" Text="To" VerticalOptions="Center"/>
            <DatePicker Grid.Column="3" Date="{Binding EndDate}"/>
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsLoading}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Expenses}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedExpense}">
                <CollectionView.EmptyView>
                    <Label Text="No expenses recorded yet."
                           HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Expense">
                        <Border Style="{StaticResource ListCard}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Category}"
                                       FontSize="16" FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="1" FontAttributes="Bold"
                                       Text="{Binding Amount, StringFormat='{0:C2}'}" />
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       FontSize="12" TextColor="Gray"
                                       Text="{Binding ExpenseDate, StringFormat='{0:d}'}" />
                                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       FontSize="13"
                                       Text="{Binding Description}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <HorizontalStackLayout Grid.Row="2" Spacing="8" HorizontalOptions="Center">
            <Button Text="Details" Command="{Binding ViewDetailsCommand}" />
            <Button Text="Edit" Command="{Binding EditExpenseCommand}" />
            <Button Text="Delete" Command="{Binding DeleteExpenseCommand}" BackgroundColor="#E74C3C" />
        </HorizontalStackLayout>

    </Grid>

</ContentPage>
