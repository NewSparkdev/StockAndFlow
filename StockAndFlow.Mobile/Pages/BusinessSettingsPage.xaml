<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockAndFlow.Mobile.Pages.BusinessSettingsPage"
             Title="Business Settings"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">

    <ContentPage.Resources>
        <Style x:Key="FieldLabel" TargetType="Label" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="2,0,0,2" />
        </Style>
        <Style x:Key="FieldEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceContainerDark}}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="16" MaximumWidthRequest="720" HorizontalOptions="Fill">

                <!-- Business details -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Business details" Style="{StaticResource SectionTitle}" />

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Business name" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding BusinessName}" Placeholder="e.g. Acme Supplies" Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Address" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Address}" Placeholder="Street address" Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="City" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding City}" Placeholder="City" Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="State" Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding State}" Placeholder="State" Style="{StaticResource FieldEntry}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Zip code" Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding ZipCode}" Placeholder="Zip" Keyboard="Numeric" Style="{StaticResource FieldEntry}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Contact -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Contact" Style="{StaticResource SectionTitle}" />

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Phone" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Phone}" Placeholder="(555) 555-5555" Keyboard="Telephone" Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Email" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Email}" Placeholder="you@business.com" Keyboard="Email" Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Website" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Website}" Placeholder="www.business.com" Keyboard="Url" Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Tax &amp; branding -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Tax &amp; branding" Style="{StaticResource SectionTitle}" />

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Tax ID" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding TaxId}" Placeholder="Tax / EIN number" Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Default sales tax state" Style="{StaticResource FieldLabel}" />
                            <Label Text="Pre-selected when recording a sale." Style="{StaticResource Caption}" />
                            <Picker ItemsSource="{Binding AllStates}"
                                    SelectedItem="{Binding SelectedDefaultState}"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    Title="No default (select per sale)" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Logo" Style="{StaticResource FieldLabel}" />
                            <Label Text="Shown on customer invoices." Style="{StaticResource Caption}" />
                            <Image Source="{Binding LogoPath, Converter={StaticResource ImagePathConverter}}"
                                   IsVisible="{Binding HasLogo}" HeightRequest="120" Aspect="AspectFit"
                                   HorizontalOptions="Start" Margin="0,4" />
                            <Button Text="Choose Logo" Command="{Binding BrowseLogoCommand}"
                                    Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Pinned action bar -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="16,10"
              BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <Button Grid.Column="0" Text="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Grid.Column="1" Text="Save" Command="{Binding SaveCommand}" />
        </Grid>

    </Grid>

</ContentPage>
